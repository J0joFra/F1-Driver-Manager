{
  "name": "f1-driver-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestionale di Formula 1: carriera da pilota o da team principal, gara simulata in 2D.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/simulate.ts",
    "sim:long": "tsx tools/simulate.ts --seasons 40 --verbose"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

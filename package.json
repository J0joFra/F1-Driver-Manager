{
  "name": "f1-driver-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestionale di Formula 1: carriera da pilota o da team principal, gara simulata in 2D.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/simulate.ts",
    "sim:long": "tsx tools/simulate.ts --seasons 40 --verbose",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "shots": "node tools/screenshots.mjs",
    "check:offers": "node tools/check-offers.mjs",
    "check:migration": "node tools/check-migration.mjs",
    "check:palette": "node tools/check-palette.mjs",
    "check:career": "tsx tools/check-career.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "playwright": "^1.49.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
